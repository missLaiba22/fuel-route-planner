# Copy to .env and adjust as needed. Every value has a default.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
FUEL_STOP_PENALTY_DOLLARS=10
MAX_STATION_DETOUR_MILES=10

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=15
ROUTE_CACHE_SECONDS=86400
